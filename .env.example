# Copy to /etc/guestbook.env on each EC2 and fill in as you build each step.

# Step 2: name each server so you can see the load balancer switching
SERVER_NAME=web-1
PORT=3000

# Step 5: EFS (shared folder). Before EFS, leave this out and the app uses ./uploads (local EBS disk)
# UPLOAD_DIR=/mnt/efs/uploads

# Step 6: RDS. Before RDS, leave DB_HOST out and the app still runs (shows "Not configured yet")
# DB_HOST=guestbook-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
# DB_USER=admin
# DB_PASSWORD=change-me
# DB_NAME=guestbook
